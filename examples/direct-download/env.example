# Copy to .env next to compose.yaml and keep it private (chmod 600).

# A Cloudflare API token with "Zone, DNS, Edit" on your zone only: the
# certificate (DNS challenge) and the optional DDNS service use it.
CF_DNS_API_TOKEN=

# The same long random string as COOK_DIRECT_EDGE_SECRET in the library's .env.
# Make one with: openssl rand -hex 32
COOK_DIRECT_EDGE_SECRET=
