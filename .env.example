# CookingFoil environment. Copy to `.env` and edit what you need.
#
# Every variable but COOK_SECRET_KEY is optional and uses the COOK_ prefix. docker-compose.yml hands
# the whole file to the container. Most settings can also be changed on the admin
# page (/admin, Settings tab) while the server runs: what you save there wins over
# the value here, and "back to compose" returns to it. Those are marked
# [admin page] below. The rest are read once at start.
#
# Never commit your real .env: it holds passwords and keys.

# REQUIRED. The key every secret the server keeps on disk is sealed with
# (AES-256-GCM): the admin authenticator, session and download signing keys,
# the Google and IGDB client secrets. It stays here, out of the data folder, so
# a copy of that folder alone opens none of them. The server does not start
# without it. Make one and keep it: a new key cannot open what the old one sealed.
#   openssl rand -base64 32
COOK_SECRET_KEY=

# The user and group the server runs as, so the files it writes on the host are
# yours. Run `id` on the host to see yours. On Synology the first admin account
# is usually 1026 and the users group 100. PUID=0 runs as root.
PUID=1000
PGID=1000

# Logging, using the `debug` library's namespaces.
DEBUG=oc-cookingfoil*

# =============================================================================
# Ports and folders (docker-compose)
# =============================================================================

# Host port published by docker-compose. The container always listens on 80.
COOK_HOST_PORT=9080

# The host folder mounted at /storage, beside docker-compose.yml unless set here
# (for example COOK_STORAGE_PATH=/volume1/cookingfoil). The server makes
# incoming, games, homebrew, retro, patches, saves, keys and data inside it.
# COOK_STORAGE_PATH=

# Upgrading from separate mounts (/games, /data, /keys, /retro, ...): add
# docker-compose.legacy.yml so those folders stay mounted until their contents
# are moved into the storage folder under the same names. This line makes every
# docker compose command include it:
# COMPOSE_FILE=docker-compose.yml:docker-compose.legacy.yml

# =============================================================================
# Running from source (npm start / npm run dev)
# =============================================================================
# docker-compose fixes the port and the folders below, so these only matter when
# you run the server without Docker.

# Port the server binds to. Must be unprivileged (>= 1024) when not root.
COOK_PORT=3001

# Folders. COOK_STORAGE_DIR holds them all (incoming, games, homebrew, retro,
# patches, saves, keys, data), made on start, but only when that folder exists.
# Each COOK_<NAME>_DIR still puts one folder anywhere. Without a storage folder,
# games is ./games and data is ./data beside the project, keys is /keys, retro is
# <data>/retro, patches, saves and homebrew are /patches, /saves and /homebrew,
# and the drop box is <games>/incoming. The values below keep data and keys
# inside the clone, so a fresh `npm run dev` needs no root.
# COOK_STORAGE_DIR=./storage
# COOK_GAMES_DIR=./games
COOK_DATA_DIR=./data
COOK_KEYS_DIR=./keys
# COOK_RETRO_DIR=
# COOK_PATCHES_DIR=/patches
# COOK_SAVES_DIR=/saves
# COOK_HOMEBREW_DIR=/homebrew
# COOK_INCOMING_DIR=

# Tools the Docker image bundles. Override only when running from source with a
# different install location. Without them the matching feature turns itself off.
#   nstool       reads names and icons from .nsp/.xci (jakcron/nstool)
#   nsz          decompresses .nsz/.xcz (nicoboss/nsz)
COOK_NSTOOL_BIN=/usr/local/bin/nstool
COOK_NSZ_BIN=/usr/bin/nsz

# Your own prod.keys, dumped from your own console. Needed to read names and
# icons out of packages. Nothing is included.
# Default: prod.keys in the keys folder (/storage/keys in the image). From
# source, point it at ./keys/prod.keys.
# COOK_PROD_KEYS_PATH=/keys/prod.keys

# =============================================================================
# First run and accounts
# =============================================================================

# With no account yet, a browser opening the server is sent to /setup. Enter the
# setup code the container log shows ("setup code: XXXX-XXXX"), make the admin
# account and register an authenticator app there. false keeps an account-less
# server open instead (only for a LAN server you don't want accounts on).
# COOK_FIRST_RUN_SETUP=true

# Preset accounts, imported once instead of using /setup. Format:
# "user:pass,user2:pass2". Leave empty and use /setup and the Users tab.
COOK_AUTH_USERS=

# Who owns this server. Display only: it becomes the account label in your
# authenticator entry and is shown on the admin pages. A Google account with this
# address is approved on its first sign-in. Never sent to signed-out visitors.
COOK_ADMIN_EMAIL=

# The admin page (/admin) asks for a second factor after sign-in: a TOTP code or
# the admin password. You do NOT have to set these: /setup registers an
# authenticator and keeps it in <data>/security/admin-totp.json, and the admin
# password is set on the Settings tab.
#
# Set the secret here only if you want to manage it yourself. It is then never
# written to disk and the in-browser enrollment is skipped. Generate one:
#   node -e "import('otplib').then(o=>o.generateSecret()).then(console.log)"
COOK_ADMIN_TOTP_SECRET=
# A way back in if both the authenticator and the admin password are lost: set a
# password here (12+ characters), restart and sign in with it. Keep it apart from
# the accounts players use.
# COOK_ADMIN_PASSWORD=
# Admin session lifetime in hours after a successful code. Default 8.
# COOK_ADMIN_SESSION_HOURS=8

# Automation tokens (Authorization: Bearer cft_…) are made on the admin page's
# Settings tab. Besides the admin API they read /shop.json, a flat catalog of
# every file ({ files: [...] }, each named with its [TITLEID][vN] stamp) meant
# for scripts. Consoles and browsers do not read it.

# [admin page] The MCP endpoint (/mcp) for AI assistants such as Claude Code and
# Codex, reached with an automation token. Off until turned on; the Settings
# tab's token page shows how to connect.
# COOK_MCP_ENABLED=false

# Bearer token for the legacy POST /api/admin/unlock endpoint. Unset disables it.
# The admin page's Logs tab and automation tokens replace it. Generate one with:
#   openssl rand -hex 32
COOK_ADMIN_TOKEN=

# =============================================================================
# Reverse proxy and addresses
# =============================================================================

# Which proxy hops may set the client address through X-Forwarded-For.
#   empty / false   no proxy: the socket address is the client
#   a list          trust only those hops, for example "loopback, uniquelocal"
#                   for a proxy or tunnel on this host or a private network.
#                   This is the recommended form: a client can't spoof its
#                   address through a proxy that appends the real one.
#   true            trust every hop. Only safe when nothing can reach the server
#                   except through the proxy.
# Leaving it empty behind a proxy makes every client look like the proxy's one
# address, so they share one rate limit and one lockout counter. The server
# detects this and warns on the admin page.
COOK_TRUST_PROXY=false

# [admin page] The address clients reach the server at. Icon and download URLs
# in the lists are absolute. By default the host is taken from each request
# (Host, or X-Forwarded-Host/Proto from a trusted proxy), so direct access needs
# nothing here. Pin it only when a proxy rewrites Host, or to force one address.
# No trailing slash.
# COOK_PUBLIC_BASE_URL=https://shop.example.org

# =============================================================================
# Direct download address (optional)
# =============================================================================
# A second https address that carries downloads only, for clients that ask for it
# (X-CookingFoil-Features: direct-token). It is a reverse proxy on THIS host that
# forwards only GET/HEAD requests with "Authorization: Bearer ...", sets
# X-Forwarded-For itself, sets Host to the direct address and adds the header
# "X-CookingFoil-Edge: <COOK_DIRECT_EDGE_SECRET>". Signed-in clients then get a
# download token and download URLs on that address. See the README.

# [admin page] The direct address. Must be https. Empty turns the feature off.
# COOK_PUBLIC_DIRECT_BASE_URL=https://dl.example.org
# [admin page] How long a download token lasts, in seconds (3600 to 604800).
# COOK_DOWNLOAD_LINK_TTL=21600
# The secret the proxy sends as X-CookingFoil-Edge, so nothing else on the docker
# network can pose as it. Set here only, never on the admin page. While it is
# empty the direct address serves nothing. Use a long random string:
#   openssl rand -hex 32
# COOK_DIRECT_EDGE_SECRET=
# Countries the direct address admits, as ISO codes (comma list). A client that
# Cloudflare places elsewhere (CF-IPCountry) keeps the normal URLs. Empty admits
# any country. Set here only.
# COOK_DIRECT_COUNTRIES=KR
# COOK_DOWNLOAD_BASE_URL is retired and ignored; use COOK_PUBLIC_DIRECT_BASE_URL.

# =============================================================================
# Sign-in protection
# =============================================================================

# Failed sign-ins before an address is locked out.
COOK_AUTH_MAX_FAILURES=5
# Auto-unlock after N hours. 0 = until an admin unlocks it on the Logs tab.
COOK_LOCKOUT_TTL_HOURS=0
# One-shot: "true" wipes ALL lockouts on the next start. Remove it afterwards.
COOK_RESET_LOCKOUTS=false
# Loopback callers (127.0.0.1, ::1, judged by the socket address) that carry no
# forwarding header skip lockout and probe tracking. "false" enforces them too.
# Set it to false behind a same-host proxy that adds no forwarding headers
# (nginx without proxy_set_header, socat, ssh -L).
COOK_LOCKOUT_TRUST_LOOPBACK=true
# Per-address rate limit (requests a minute) and burst budget. Sized for real
# traffic: a console install pulls a title in many Range requests, and the web
# page asks for one icon per title. Throttling either shows up on the console as
# a bare "install failed". Lower it only if you are actually being flooded.
COOK_RATE_LIMIT_PER_MIN=1200
COOK_RATE_LIMIT_BURST=300

# The message that answers a refused sign-in.
COOK_UNAUTHORIZED_MSG=No tricks and treats for you!!

# =============================================================================
# Device pairing (CookingFoil client)
# =============================================================================
# [admin page] QR device connection. When on, the /api/pair/* endpoints go live:
# the CookingFoil client shows a QR code, you scan it with your phone, sign in and
# approve, and the console gets its own access key. Consoles never use a
# password for ongoing access; an ID and password can be used once, at pairing,
# to approve the console automatically (see below). Off: no console can connect.
COOK_DEVICE_PAIRING=true
# [admin page] How consoles are approved while pairing is on:
#   true    a console that sends an account's ID and password once, at pairing,
#           is approved at once; consoles that send none wait for the admin
#   false   every console waits for the admin (manual approval)
#   all     every console that asks is approved, signed in or not. Only for a
#           server that nothing but your own consoles can reach
COOK_DEVICE_AUTO_APPROVE=true

# How many approved consoles one account may hold, however they were approved
# (a downloaded client, a QR approval, a sign-in at pairing). 0 is no limit.
# The admin page's Settings tab can change it while the server runs.
COOK_DEVICE_LIMIT=10

# How many different consoles one account's downloaded clients may connect on
# their own in any hour, counted across all of its downloads (1 to 50). More
# consoles are approved by QR. The Settings tab can change it while the server runs.
COOK_ENROLL_PER_HOUR=5

# =============================================================================
# Names, icons and titledb
# =============================================================================

# [admin page] Display-language order for names (first match wins).
# Examples: "ko,en,ja", "en,ja", "ja,en".
COOK_LANG_PRIORITY=ko,en,ja

# [admin page] blawar/titledb region files to fetch and merge, first match per
# field wins. Unset uses a built-in global set.
COOK_TITLEDB_REGIONS=KR.ko,US.en,JP.ja,EU.en,HK.zh
# [admin page] "false" never downloads titledb (the server then uses whatever you
# put under <data>/titledb/ by hand).
COOK_TITLEDB_AUTO_FETCH=true
# [admin page] Where titledb is read from: an address holding <region>.json files.
# Empty is blawar/titledb. Point it at a fork or mirror if that one stops.
# COOK_TITLEDB_URL=https://raw.githubusercontent.com/<you>/titledb/master
# How often to refresh titledb while running, in hours. The schedule follows the
# cache's age, so a restart doesn't reset it. 0 disables the scheduled refresh
# (the first download still happens).
COOK_TITLEDB_REFRESH_INTERVAL_HOURS=24

# [admin page] Where the CookingFoil client build comes from. "manual" (the
# default) offers only a build uploaded on the admin page or put in
# <data>/client/. "github" also follows the client repository's latest release
# every 30 minutes and offers whichever build is newer. A private repository
# needs the GitHub token from the admin page's integrations.
COOK_CLIENT_SOURCE=manual
# COOK_CLIENT_RELEASE_REPO=jshsakura/oc-cookingfoil-client
# Empty follows the latest release; a tag follows that release instead.
# COOK_CLIENT_RELEASE_TAG=
# COOK_CLIENT_RELEASE_ASSET=cookingfoil.nro

# [admin page] When to read the icon (and a fallback name and publisher) out of
# the package itself:
#   missing  only for titles titledb doesn't cover (homebrew, fan-made, unknown
#            ids). Listed titles keep their titledb name and icon. The default.
#   all      for every title, so covers work fully offline. Unpacks multi-GB
#            files; use it only on a LAN without internet access.
#   off      never.
# Reading needs prod.keys and nstool (nsz for .nsz/.xcz); without them it falls
# back to titledb and the file name.
COOK_EXTRACT_ICONS=missing
# Extraction workers running at once.
COOK_EXTRACT_CONCURRENCY=2
# Deadline for one extraction, in ms. A timeout leaves that title with its file
# name. Default 10 minutes; raise it on slow disks.
COOK_EXTRACT_TIMEOUT_MS=600000
# Skip extracting packages larger than this many GB (they keep the file name).
# 0 or negative removes the cap. Default 4.
COOK_EXTRACT_MAX_GB=4
# Pause between extraction jobs in ms, so the first pass never saturates the
# disk while serving. 0 disables it. Default 250.
COOK_EXTRACT_PACE_MS=250

# Custom shop entries (homebrew, fan content) as a JSON5 file.
# Default: <games>/custom_entries.jsonc.
COOK_CUSTOM_ENTRIES=

# =============================================================================
# Public store data, ratings and retro details
# =============================================================================
# Each can be turned off; the shop keeps working without them.

# [admin page] Prices and sales from the public store price service, re-read
# every 12 hours.
# COOK_ESHOP_PRICES=true
# [admin page] The "popular" order, from the public store search index.
# COOK_ESHOP_POPULARITY=true
# Override the public search-only credentials that index gives every visitor.
# COOK_ESHOP_ALGOLIA_APP_ID=
# COOK_ESHOP_ALGOLIA_KEY=
# [admin page] Icons, banners and screenshots from the public store artwork
# service, cached on disk. Also allows retro screenshots to be saved.
# COOK_ESHOP_ARTWORK=true

# [admin page] Steam review scores for every base title, looked up by English
# name (near-exact matches only) and refreshed weekly. No key needed.
# COOK_RATING_SYNC=true
# [admin page] Retro game details for the game pages (description, publisher,
# developer, release date, players, genres) from the LaunchBox Games Database,
# with IGDB (keys below) for what LaunchBox lacks, and up to 8 screenshots per
# game saved under <retro>/screenshots/ (only while COOK_ESHOP_ARTWORK is on).
# Refreshed weekly.
# COOK_RETRO_META=true
# [admin page] Box art for retro ROMs a folder scan finds without any: the same
# job as the retro tab's download button, for those systems only, each ROM
# looked up once (content hash, then English title). ROM files are never touched.
# COOK_RETRO_AUTO_ART=true
# [admin page] A ROM folder under <retro>/roms/ for every system the Switch can
# run, and the BIOS folder, made at every retro scan when missing. Nothing is
# moved, deleted or written into a folder. What goes in each folder is served by
# GET /admin/api/storage-guide, not written to disk.
# COOK_RETRO_SCAFFOLD=true

# =============================================================================
# Outside-service keys
# =============================================================================
# All optional, and all can be entered on the admin page (Settings tab), which
# says where to get each one. What you save there wins over these.

# IGDB scores and retro details: a Twitch application's client id and secret
# (https://dev.twitch.tv/console/apps).
# COOK_IGDB_CLIENT_ID=
# COOK_IGDB_CLIENT_SECRET=
# SteamGridDB key, for picking covers by hand
# (https://www.steamgriddb.com/profile/preferences/api).
# COOK_STEAMGRIDDB_KEY=
# GitHub token (public repositories, no extra permissions). Raises GitHub's limit
# from 60 to 5,000 requests an hour for homebrew checks and retro art lists.
# COOK_GITHUB_TOKEN=
# Addresses the server fetches (the titledb source and the direct download
# address) may not point into a private network: loopback,
# private, CGNAT, link-local and cloud metadata addresses are refused, also when
# a name resolves to one. List here, comma separated, host names that may
# resolve to a private, loopback or CGNAT address anyway (a titledb mirror on a
# tailnet, for example). Set only here, never on the admin page.
# COOK_OUTBOUND_PRIVATE_HOSTS=

# =============================================================================
# Dropbox save sync (CookingFoil client)
# =============================================================================
# The client backs up and syncs saves to the player's own Dropbox. This server
# only relays the sign-in; no saves or tokens pass through it. Create an app at
# https://www.dropbox.com/developers/apps (Scoped access, App folder), add the
# redirect URI  <your server address>/api/dropbox/oauth/dropbox/callback  and set
# COOK_DROPBOX_REDIRECT_BASE to that https address (it only affects this
# callback). Only the app key is needed (PKCE). Never put the app secret here.
# COOK_DROPBOX_APP_KEY=
# COOK_DROPBOX_REDIRECT_BASE=https://shop.example.org

# =============================================================================
# Google sign-in
# =============================================================================
# People sign in with Google at /login, for example to approve a console's QR
# code. New accounts wait until an admin approves them (Users tab); the
# COOK_ADMIN_EMAIL address is approved on its first sign-in. Create an OAuth
# client (type "Web application") in the Google Cloud console and add the
# redirect URI  <your server address>/auth/google/callback. The base defaults to
# COOK_DROPBOX_REDIRECT_BASE, then COOK_PUBLIC_BASE_URL. Also on the admin page.
# COOK_GOOGLE_CLIENT_ID=
# COOK_GOOGLE_CLIENT_SECRET=
# COOK_GOOGLE_REDIRECT_BASE=https://shop.example.org

# =============================================================================
# Telegram alerts
# =============================================================================
# Usually set on the admin page (Alerts tab); these are the fallback.
# COOK_TELEGRAM_BOT_TOKEN=
# COOK_TELEGRAM_CHAT_ID=
# Which events, comma-separated: device, account, lockout, probe, inbox, direct,
# server. Empty means the defaults (all but server).
# COOK_TELEGRAM_EVENTS=
# "off" removes the approve and reject buttons from approval alerts. On unless
# set, which means whoever holds the chat can approve.
# COOK_TELEGRAM_BUTTONS=
# In a group chat, the Telegram user ids allowed to press them (comma-separated).
# COOK_TELEGRAM_APPROVERS=

# =============================================================================
# Uploads and the share inbox
# =============================================================================

# [admin page] Web uploads on the admin page (games, retro ROMs, patches, saves,
# homebrew) and artwork uploads for a title. Off by default. Sign-in and lockout
# still apply.
COOK_UPLOADS_ENABLED=false
# Largest single upload in bytes. Default 32 GiB, enough for large XCI files.
# COOK_UPLOAD_MAX_BYTES=34359738368

# [admin page] Share inbox: signed-in users leave files, a memo and links under
# <data>/inbox for the operator to sort later.
# COOK_INBOX_ENABLED=true
# [admin page] Largest single drop (all its files together). Default 2 GiB.
# COOK_INBOX_MAX_BYTES=2147483648
# [admin page] The whole inbox; new drops are refused once it is full.
# Default 20 GiB.
# COOK_INBOX_QUOTA_BYTES=21474836480

# =============================================================================
# Homebrew
# =============================================================================
# .nro apps for clients to keep in sdmc:/switch/<app>/. Hand-placed ones go in
# <homebrew>/<app folder>/<app>.nro. GitHub repositories are added on the admin
# page (Homebrew tab) and followed through their latest release (a .nro, or a
# .zip with one inside).

# Hours between release checks. "Check now" on the admin page ignores it.
# COOK_HOMEBREW_CHECK_HOURS=6
# Seeds the admin page's repository list on the first start only (owner/name,
# comma-separated).
# COOK_HOMEBREW_REPOS=owner/name

# =============================================================================
# Downloads and safe restart
# =============================================================================

# [admin page] How many connections one console may open for one download (1-8).
# Sent to clients as a hint (X-CookingFoil-Max-Connections and /api/shop/info),
# not enforced.
# COOK_DOWNLOAD_MAX_CONNECTIONS=4

# [admin page] On docker stop (or the admin page's restart button) the server
# stops taking new requests, answers them 503 with Retry-After, and lets running
# ones finish for up to the grace seconds (at most 35, inside compose's
# stop_grace_period of 40 s) before it exits. A restart from the admin page exits
# with code 75 so a supervisor (Docker's restart policy, systemd
# Restart=on-failure) starts it again; a stop by signal exits 0.
# COOK_RESTART_RETRY_AFTER=20
# COOK_RESTART_GRACE=25

# =============================================================================
# NSZ conversion queue
# =============================================================================
# The admin page's 변환 tab compresses .nsp files in the games folder to .nsz
# (nsz -C -V: compress, then verify) and swaps them in place. The admin starts
# and pauses it there; every value below is also on that tab and applies
# without a restart. A new file starts only after downloads have been idle for
# 30 seconds, so consoles keep the disks. Work happens in
# <games>/.cookingfoil-nsz-work, which the library never lists.

# [admin page] Off until turned on.
# COOK_NSZ_ENABLED=false
# [admin page] Queue new .nsp files the library finds by themselves.
# COOK_NSZ_AUTO_QUEUE=true
# [admin page] zstd level (1-22) and threads per file.
# COOK_NSZ_LEVEL=18
# COOK_NSZ_THREADS=4
# [admin page] Files at once (1-3). More finish sooner but slow downloads.
# COOK_NSZ_WORKERS=1
# [admin page] Files smaller than this (MB) are left alone.
# COOK_NSZ_MIN_SIZE_MB=100
# [admin page] Pause when free space on the games folder drops below this (GB, 0 = no check).
# The queue never deletes anything to make room: it pauses and says how much the
# trash holds, since converted originals wait there until the trash is emptied.
# COOK_NSZ_DISK_FLOOR_GB=0
# [admin page] Hours to keep the original after a verified swap in
# <games>/.cookingfoil-nsz-keep before it goes to the trash (0-168, 0 = to the
# trash at once, the default). Nothing is deleted: the trash keeps it until
# someone empties the trash on the admin page.
# COOK_NSZ_KEEP_HOURS=0
# [admin page] At most this much kept in all (GB, 0 = no cap); past it the
# oldest go to the trash first.
# COOK_NSZ_KEEP_GB=0
# [admin page] Block compression (nsz -B) instead of solid. Off: the client is
# as fast with solid files.
# COOK_NSZ_BLOCK=false
# [admin page] .xci to .xcz too. Off: the client's .xcz install is not
# verified on a device yet.
# COOK_NSZ_XCI=false
# The nsz binary (the image ships it; also used to read .nsz/.xcz files).
# COOK_NSZ_BIN=/usr/bin/nsz

# [admin page] The trash: whatever the server removes from a library folder goes
# to <that folder>/.cookingfoil-trash and stays until someone empties the trash
# on the admin page. It is never emptied by itself; entries older than this many
# days are only pointed out there (1-3650).
# COOK_TRASH_NOTICE_DAYS=30

# =============================================================================
# Local test harness (npm run test:pairing, npm run test:basic)
# =============================================================================
# Boots the real server with pairing forced on and a fresh temporary data folder,
# so you can try the pairing and sign-in lanes with curl or the client without
# touching ./data. It also reads COOK_PORT, COOK_AUTH_USERS and
# COOK_ADMIN_TOTP_SECRET above.
#
# Devices to pre-approve, comma-separated, each "64hex" or "64hex=label". A
# one-time access key is printed for each. Empty: approve by hand in /admin.
COOK_LOCAL_DEVICES=A1B2C3D4E5F60718293A4B5C6D7E8F90A1B2C3D4E5F60718293A4B5C6D7E8F90=friend-console,B1B2C3D4E5F60718293A4B5C6D7E8F90A1B2C3D4E5F60718293A4B5C6D7E8F90=my-console
# Keep approvals between runs under ./local-test/data.
# COOK_LOCAL_KEEP_DATA=false
# Serve real files instead of an empty library.
# COOK_LOCAL_GAMES_DIR=
# "false" quiets the harness's request log.
# COOK_LOCAL_VERBOSE=true
