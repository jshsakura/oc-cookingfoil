# CookingFoil environment — copy to `.env` and edit.
# All variables use the COOK_ prefix.

# Logging (uses the `debug` library namespace).
DEBUG=oc-cookingfoil*

# Host port published by docker-compose. Container always listens on 80.
COOK_HOST_PORT=9080

# --- Folders (docker-compose) ---
# Host folders mounted into the container. Each one is made under COOK_ROOT
# (default: beside docker-compose.yml) unless its own path is set; Docker
# creates the ones that are missing. Inside the container they stay at
# /games /data /keys /retro /patches /saves /homebrew.
# COOK_ROOT=/mnt/storage/cookingfoil
# COOK_GAMES_PATH=
# COOK_DATA_PATH=
# COOK_KEYS_PATH=
# COOK_RETRO_PATH=
# COOK_PATCHES_PATH=
# COOK_SAVES_PATH=
# COOK_HOMEBREW_PATH=

# Inside-container port. The container always overrides to 80 via Dockerfile
# ENV; this value is what local `npm start` / `npm run dev` and Playwright CI
# bind to, so it MUST be unprivileged (>= 1024) to avoid EACCES on non-root.
COOK_PORT=3001

# Where game files live. Default (unset) resolves to ./games relative to
# wherever you start the server. The Docker image overrides this to /games
# via ENV in the Dockerfile, so leave it unset for local development.
# COOK_GAMES_DIR=./games

# Persistent runtime cache (extracted icons + titledb).
COOK_DATA_DIR=/data

# Console keys folder (read-only). Drop your own prod.keys into ./keys/.
COOK_KEYS_DIR=/keys

# Optional path to user-supplied custom shop entries (homebrew, fan content).
# Defaults to ${COOK_GAMES_DIR}/custom_entries.jsonc when unset.
COOK_CUSTOM_ENTRIES=

# Display-language preference for NACP / titledb merge (first match wins).
# Examples: "ko,en,ja"  or  "en,ja"  or  "ja,en"
COOK_LANG_PRIORITY=ko,en,ja

# Basic auth. Empty = no auth. Format: "user:pass,user2:pass2".
COOK_AUTH_USERS=

# Messages.
COOK_UNAUTHORIZED_MSG=No tricks and treats for you!!
COOK_WELCOME_MSG=CookingFoil is serving fresh.

# --- Community titledb (blawar/titledb) ---
# Region/lang files to fetch + merge. First match per field wins, falling
# back through COOK_LANG_PRIORITY. Default fetches a sensible global set.
COOK_TITLEDB_REGIONS=KR.ko,US.en,JP.ja,EU.en,HK.zh

# Set to "false" to never auto-download on cold start (server then runs with
# whatever you've put under ${COOK_DATA_DIR}/titledb/ manually).
COOK_TITLEDB_AUTO_FETCH=true

# --- Artwork URLs (CyberFoil/AeroFoil) ---
# The shop hands out ABSOLUTE icon/banner/screenshot URLs so CyberFoil/AeroFoil
# can fetch them (they curl the per-item URL verbatim; a host-relative path has
# no host to resolve). By default the origin is derived per-request from the
# Host header — leave this unset for the common case. Pin it only when behind a
# proxy that rewrites Host, or to force a canonical address. No trailing slash.
# NOTE: stock Tinfoil ignores per-item icon URLs entirely (its index spec has
# no icon field), so server-served icons only show on CyberFoil/AeroFoil.
#
# Both icon AND file-download URLs are emitted ABSOLUTE (CyberFoil needs a full
# host for icons, and resolves downloads via BuildFullUrl where a relative path
# breaks). The host is auto-derived per request from Host / X-Forwarded-Host, so
# direct IP access needs nothing here. Behind a reverse proxy, either set
# COOK_TRUST_PROXY=true (and have the proxy forward X-Forwarded-Host/Proto) or
# pin this to the exact external address for a guaranteed-correct host.
# COOK_PUBLIC_BASE_URL=http://192.168.1.50:9080

# --- Security ---
# Behind a reverse proxy? Set to "true" so req.ip honours X-Forwarded-For.
# IMPORTANT: leaving this false behind a proxy makes every client look like the
# proxy's single IP — they then SHARE one rate-limit budget and one lockout
# counter, so one stranger's failures throttle or lock out everyone. The server
# detects this and warns on the /admin dashboard.
COOK_TRUST_PROXY=false
# How many failed auth attempts before the IP is locked out.
COOK_AUTH_MAX_FAILURES=5
# Auto-unlock after N hours. 0 = forever (admin unlock required).
COOK_LOCKOUT_TTL_HOURS=0
# One-shot: set to "true" to wipe ALL lockouts on next boot. Reset afterwards.
COOK_RESET_LOCKOUTS=false
# Loopback callers (127.0.0.1, ::1) bypass lockout/probe tracking by default —
# they already have local shell access. Set to "false" to enforce strictly.
COOK_LOCKOUT_TRUST_LOOPBACK=true
# Per-IP rate limit (requests/min) and burst budget. Sized for real traffic:
# a console install pulls a title in 16MB range requests (hundreds of requests
# for one big file) and the dashboard grid fires one icon request per title.
# Throttling either of those shows up on the console as a bare "install failed".
# Lower it only if you're actually being flooded.
COOK_RATE_LIMIT_PER_MIN=1200
COOK_RATE_LIMIT_BURST=300
# Admin token for POST /api/admin/unlock. Unset = admin endpoint disabled.
# Generate with: openssl rand -hex 32
COOK_ADMIN_TOKEN=

# --- First run ---
# With no account yet, a browser opening the server is sent to /setup. Enter the
# setup code the container log shows ("setup code: XXXX-XXXX"), make the admin
# account and register an authenticator app there. false keeps an account-less
# server open instead (a LAN-only server you don't want accounts on).
# COOK_FIRST_RUN_SETUP=true

# --- Outside-service keys ---
# IGDB, SteamGridDB, Dropbox, GitHub and the ratings server can all be set on the
# admin page (settings tab), which also says where to get each key. What you save
# there wins over the env vars below, which stay as a way to preset them.
# SteamGridDB API key (https://www.steamgriddb.com/profile/preferences/api):
# cover and icon search when matching items by hand.
# COOK_STEAMGRIDDB_KEY=

# --- /admin dashboard (2FA) ---
# Who owns this server. Optional, display only: it becomes the account label in
# your authenticator entry ("CookingFoil (you@example.com)" instead of a generic
# "admin") and is shown on the admin pages. Never sent to unauthenticated
# clients. An invalid address is ignored with a warning at boot.
COOK_ADMIN_EMAIL=

# The /admin page (auth-lane health, access denials, lockouts, device approval)
# sits inside the basic-auth perimeter and adds a TOTP second factor.
#
# You do NOT have to set this. /setup registers one on first run and keeps it in
# <data>/security/admin-totp.json. (Servers that already have accounts but no
# authenticator still get the old way: the otpauth:// URI in the log and the key
# at /admin for local-network visitors until the first valid code.) (/admin is always mounted —
# otherwise a pairing server could have no way to approve any device.)
#
# Set it explicitly if you'd rather manage the secret yourself; then it is never
# written to disk and the in-browser enrollment page is skipped. Generate one:
#   node -e "import('otplib').then(o=>o.generateSecret()).then(console.log)"
COOK_ADMIN_TOTP_SECRET=
# No authenticator app? Set an admin password (12+ characters) and /admin asks
# for it instead of a code. Keep it apart from COOK_AUTH_USERS, which players share.
# COOK_ADMIN_PASSWORD=

# --- Public store data ---
# These call public store endpoints. Each can be turned off; the
# shop keeps working without them (no prices, no popularity order, artwork
# only from the files themselves or the admin page).
# Prices and sales, from the public price API, re-read every 12 hours.
# COOK_ESHOP_PRICES=true
# The "popular" order, from the public US store search index.
# COOK_ESHOP_POPULARITY=true
# Override the public search-only credentials that index ships to visitors.
# COOK_ESHOP_ALGOLIA_APP_ID=
# COOK_ESHOP_ALGOLIA_KEY=
# Icons, banners and screenshots from the public artwork CDN (cached on disk).
# COOK_ESHOP_ARTWORK=true

# --- Patches ---
# Patches for clients to place on the SD card: <base title id>/<patch folder>/
# laid out like the SD card root, plus an optional patch.json; a homebrew app's
# go in homebrew/<app>/<patch folder>/. Docker fixes this to /patches.
# COOK_PATCHES_DIR=/patches

# --- Homebrew ---
# .nro apps for clients to keep in sdmc:/switch/<app>/. Hand-placed ones go in
# <dir>/<app folder>/<app>.nro. GitHub repositories are
# added on the admin page (Homebrew tab) and followed through their latest
# release (a .nro, or a .zip with one inside): checked every
# COOK_HOMEBREW_CHECK_HOURS (default 6); "check now" on the admin page ignores it.
# COOK_HOMEBREW_CHECK_HOURS=6
# COOK_HOMEBREW_DIR=/homebrew
# Seeds the admin page's list on the first start only (owner/name, comma-separated).
# COOK_HOMEBREW_REPOS=murat303/ytb-player
# Optional; GitHub allows 60 requests an hour without one.
# COOK_GITHUB_TOKEN=

# --- Shop template ---
# JSON5 file merged into shop.tfl (welcome message, custom headers, ...).
# COOK_SHOP_TEMPLATE=/shop_template.jsonc

# --- Dropbox save sync (CookingFoil client) ---
# The client backs up and syncs save data to the player's own Dropbox; this
# server only relays the sign-in (no saves or tokens pass through it). Create
# an app at https://www.dropbox.com/developers/apps (Scoped access, App folder),
# add the redirect URI  <your server address>/api/dropbox/oauth/dropbox/callback
# and set COOK_DROPBOX_REDIRECT_BASE to that same https address (it only
# affects this callback; COOK_PUBLIC_BASE_URL also works but rewrites every
# address the server hands out). Only the app key is needed (PKCE); never put
# the app secret here.
# COOK_DROPBOX_APP_KEY=
# COOK_DROPBOX_REDIRECT_BASE=

# --- Google sign-in (phone approval pages) ---
# People sign in with Google at /login to approve a console's QR or device
# code. New accounts wait until the admin approves them in /admin (users tab);
# the COOK_ADMIN_EMAIL address is approved on its first sign-in. Create an
# OAuth client (type "Web application") in the Google Cloud console and add
# the redirect URI  <your server address>/auth/google/callback. The base
# defaults to COOK_DROPBOX_REDIRECT_BASE, then COOK_PUBLIC_BASE_URL.
# COOK_GOOGLE_CLIENT_ID=
# COOK_GOOGLE_CLIENT_SECRET=
# COOK_GOOGLE_REDIRECT_BASE=

# --- Review scores ---
# CookingFoil looks up Steam review scores for every base title by its English
# name (near-exact matches only) and refreshes them weekly. No key needed.
# COOK_RATING_SYNC=true
# IGDB scores too: a Twitch application's client id and secret (dev.twitch.tv).
# COOK_IGDB_CLIENT_ID=
# COOK_IGDB_CLIENT_SECRET=
# oc-scraper base URL, an extra source of Steam / IGDB / RAWG scores.
# COOK_RATINGS_URL=
# Admin session lifetime (hours) after a successful code. Default 8.
# COOK_ADMIN_SESSION_HOURS=8

# --- Device pairing (CookingFoil client) ---
# Opt-in, ADDITIVE lane. When on, the public /api/pair/* endpoints go live and a
# CookingFoil client console that has been APPROVED (in the /admin dashboard) can connect
# with NO password — it presents a hardware-bound device key (UID) plus a
# server-issued access key. Basic-auth (Tinfoil) keeps working alongside it.
#
# Onboarding: friend enters just your domain (or IP:port) → their console shows
# its device key as a QR → they photograph it and send it to you → you approve
# it in /admin → the server hands the device
# a one-time access key on its next poll. No password is ever shared.
#
# For a pairing-ONLY server ("only approved devices, no shared password"), set
# this true AND leave COOK_AUTH_USERS empty — then an approved device is the
# sole way past the shop/download surface.
#
# !! STOCK TINFOIL AND STOCK CYBERFOIL CANNOT PAIR. It has no way to send a device key, so in the
# pairing-only configuration every Tinfoil or CyberFoil request is refused (Tinfoil usually
# renders that as an instant, empty "Complete"). Keep COOK_AUTH_USERS set if any
# Tinfoil or CyberFoil client needs access — the two lanes run side by side. The server
# warns about this at boot and on the /admin dashboard.
COOK_DEVICE_PAIRING=false
# With pairing on, approve a console as soon as it signs in with an account or
# its device login (no QR scan); it picks up its access key on its next pairing
# poll. Consoles with no sign-in still wait for approval.
COOK_DEVICE_AUTO_APPROVE=false

# --- Local test harness (npm run test:pairing) ---
# Boots the real server with COOK_DEVICE_PAIRING forced on (and a fresh temp
# data dir) so you can exercise the pairing + basic-auth lanes from curl or the
# NRO without touching your real ./data. Everything below is optional — the
# harness also reads COOK_PORT / COOK_AUTH_USERS / COOK_ADMIN_TOTP_SECRET above.
#
# Devices to pre-approve on boot so you can curl immediately. Comma-separated,
# each "64hex" or "64hex=label". Generates a one-time accessKey per device and
# prints it. Leave empty to drive the knock→approve flow by hand in /admin.
COOK_LOCAL_DEVICES=A1B2C3D4E5F60718293A4B5C6D7E8F90A1B2C3D4E5F60718293A4B5C6D7E8F90=friend-console,B1B2C3D4E5F60718293A4B5C6D7E8F90A1B2C3D4E5F60718293A4B5C6D7E8F90=my-console
# Persist approvals across runs under ./local-test/data (fresh temp dir by
# default, so pending/approved state resets each run).
# COOK_LOCAL_KEEP_DATA=false
# Serve real files instead of an empty library.
# COOK_LOCAL_GAMES_DIR=

# How often to auto-refresh the titledb cache while the server runs.
# Re-scheduling is cache-mtime-aware, so a restart doesn't reset the clock.
# Set to 0 to disable scheduled refresh (cold-start fetch still works).
COOK_TITLEDB_REFRESH_INTERVAL_HOURS=24

# Web-based file uploads (POST /api/uploads → temp/ → Apply → games/).
# Disabled by default. When enabled the upload tray FAB shows up in the
# dashboard. Auth + IP-lockout perimeter still apply.
# This flag ALSO enables title-artwork uploads (icon/banner/screenshot) in the
# per-title detail modal — POST /api/art/<titleId>/<kind>. Uploaded images are
# re-encoded by sharp and stored under ${COOK_DATA_DIR}/custom-art, overriding
# the titledb CDN artwork and NACP-extracted icons.
COOK_UPLOADS_ENABLED=false
# Max single-file upload size in bytes. Default ~32 GiB covers dual-layer
# XCI dumps; lower this if you want a tighter guardrail.
# COOK_UPLOAD_MAX_BYTES=34359738368

# When to pull the icon (and fallback name/publisher) straight out of the
# package file instead of leaning on blawar/titledb's CDN URL:
#   all     — extract for EVERY title, so covers render fully OFFLINE and the
#             on-device icon matches the actual file. titledb's CDN URL is a
#             fallback only. Needs prod.keys + nstool (below); degrades to the
#             CDN when they're absent. Requires prod.keys + nstool and
#             needlessly unpacks multi-GB XCI/NSZ — use ONLY on a LAN with no
#             internet, where the CDN is unreachable.
#   missing — extract ONLY titles titledb can't cover (homebrew/fan/synthetic
#             IDs). Listed titles keep their titledb name + CDN icon
#             (both already known from the filename's title ID — no unpack).
#             This is the lean default; needs internet to first pull covers.
#   off     — never extract.
# DEFAULT is "missing": don't unpack a 6 GB XCI just to read a name/icon the
# titledb + CDN already have. Set "all" only for an offline LAN shop.
COOK_EXTRACT_ICONS=missing

# --- Publish titledb in the shop response? ---
# OFF by default, and that's intentional. CyberFoil/AeroFoil's legacy parser
# turns EVERY titledb entry into a list item with an empty download url —
# a "ghost" row that can't be selected or installed (A/＋ do nothing on it).
# Per-file entries already carry name + size + titleId + icon_url, and CyberFoil
# pulls richer metadata from its own offline DB, so leaving this off is the
# right call for CyberFoil/AeroFoil. Set to "true" ONLY for stock Tinfoil,
# whose detail view / search reads the titledb override map.
# COOK_EMIT_TITLEDB=true

# NACP extraction worker concurrency. NRO files always get a pure-JS
# parse. NSP/XCI use nstool below (when configured); NSZ/XCZ stay
# uncovered until a decompress stage lands.
COOK_EXTRACT_CONCURRENCY=2

# Path to an `nstool` binary (jakcron/nstool) for NSP/XCI metadata
# extraction. The shipped Docker image bundles nstool at
# /usr/local/bin/nstool — override only if you're running from source
# with a different install location. If the binary can't be resolved,
# NSP/XCI containers fall back to filename-derived metadata.
COOK_NSTOOL_BIN=/usr/local/bin/nstool
# Path to an `nsz` binary (nicoboss/nsz) for NSZ/XCZ decompression.
# Shipped image bundles nsz via pip at /usr/bin/nsz. NSZ/XCZ are
# decompressed into a tempdir, then handed to the NSP path.
COOK_NSZ_BIN=/usr/bin/nsz
# prod.keys location for NSP/XCI/NSZ/XCZ decryption. Default matches the
# legacy tinfoil-hat /keys mount layout. Required for any keyed
# extractor — the provider checks and skips silently if missing.
COOK_PROD_KEYS_PATH=/keys/prod.keys
# Per-extraction subprocess deadline (ms). Multi-gigabyte XCI dumps +
# NSZ decompress on a busy box can blow past 2 min — and a timeout means
# that title's NAME/ICON never gets extracted, so it falls back to the
# (often garbage) filename. Default is 10 min; raise further on slow disks
# or a heavily loaded server. See /healthz nameHealth + the dashboard panel.
COOK_EXTRACT_TIMEOUT_MS=600000

# Auto-extraction size cap (GB). Even in "missing" mode, a genuinely-uncovered
# giant container (≥6 GB XCI / NSZ) shouldn't be allowed to grind for minutes
# and hit the timeout above — it's SKIPPED and keeps its filename fallback
# (rare, acceptable). 0 or negative disables the cap (unlimited). Default 4.
COOK_EXTRACT_MAX_GB=4
# Inter-job pacing (ms) for the background extraction worker — a small gap
# between jobs so the one-time pass runs gently and never saturates disk/CPU
# while serving shop requests. Concurrency is unchanged; this only spaces jobs
# out. 0 disables the delay. Default 250.
COOK_EXTRACT_PACE_MS=250
