+static bool g_forwarded = false;
+
+// Copy a romfs file holding one line of text into dst (NUL-terminated).
+static bool readRomfsText(const char* path, char* dst, size_t size)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return false;
+    ssize_t n = read(fd, dst, size - 1);
+    close(fd);
+    if (n <= 0)
+        return false;
+    while (n > 0 && (dst[n-1] == '\n' || dst[n-1] == '\r'))
+        n--;
+    dst[n] = '\0';
+    return n > 0;
+}
+
+// The NRO to start and its argv, from romfs:/nextNroPath and romfs:/nextArgv.
+static bool readForwardTarget(void)
+{
+    if (R_FAILED(romfsInit()))
+        return false;
+    bool ok = readRomfsText("romfs:/nextNroPath", g_nextNroPath, sizeof(g_nextNroPath))
+           && readRomfsText("romfs:/nextArgv", g_nextArgv, sizeof(g_nextArgv));
+    romfsExit();
+    if (!ok)
+        g_nextNroPath[0] = '\0';
+    return ok;
+}
