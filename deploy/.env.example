# Copy to .env next to docker-compose.yml and fill in.

# Where things live on the host.
GAMES_DIR=/path/to/switch/games
DATA_DIR=./data
KEYS_DIR=./keys
PATCHES_DIR=./patches

COOK_HOST_PORT=38000
TZ=Asia/Seoul

# user:password pairs, comma separated. Use long random passwords:
#   openssl rand -base64 24
COOK_AUTH_USERS=me:change-this-to-a-long-random-password

# Optional
COOK_ADMIN_PASSWORD=
COOK_WELCOME_MSG=Welcome to my shop
COOK_DEVICE_PAIRING=false
COOK_LANG_PRIORITY=en,ko,ja,en-US
COOK_IGDB_CLIENT_ID=
COOK_IGDB_CLIENT_SECRET=
